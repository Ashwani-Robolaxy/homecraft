rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users: anyone can create their own doc on signup; only owner can read/update.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId;
    }
    // Providers: extended profile for role=provider; same ownership.
    match /providers/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    // Projects and other collections: add rules when you implement them.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
